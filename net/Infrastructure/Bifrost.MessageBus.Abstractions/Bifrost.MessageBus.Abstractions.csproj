<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bifrost.MessageBus</RootNamespace>
    <Description>
      Bifrost message bus abstractions: IBifrostBus for planes, IMessageBusProvider for broker
      sidecars, and the RPC wire contracts that connect them.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.0"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bifrost.Rpc.Abstractions\Bifrost.Rpc.Abstractions.csproj" />
    <ProjectReference
      Include="..\Bifrost.Rpc.Generators\Bifrost.Rpc.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
