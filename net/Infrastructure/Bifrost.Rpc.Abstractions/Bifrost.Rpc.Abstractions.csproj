<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bifrost.Rpc</RootNamespace>
    <Description>Shared RPC abstractions: IRpcContract, IRpc&lt;T&gt;, RpcSession, and the peer connection contract.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.0"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\Bifrost.Rpc.Generators\Bifrost.Rpc.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
