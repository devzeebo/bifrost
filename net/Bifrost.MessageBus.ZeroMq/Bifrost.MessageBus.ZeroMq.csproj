<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bifrost.MessageBus.ZeroMq</RootNamespace>
    <Description>Bifrost message bus sidecar bound to ZeroMQ (DEALER/ROUTER + pub frames).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="NetMQ" Version="4.0.4.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bifrost.MessageBus.Abstractions\Bifrost.MessageBus.Abstractions.csproj" />
    <ProjectReference Include="..\Bifrost.Rpc\Bifrost.Rpc.csproj" />
  </ItemGroup>
</Project>
