#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE=(docker compose -f "$ROOT/bifrost-server/docker-compose.yml")
PIDS=()
STARTED_STACK=0

cleanup() {
  trap - EXIT INT TERM
  echo
  echo "Stopping frontends…"
  for pid in "${PIDS[@]:-}"; do
    # Signal the process group even if the pnpm leader has already exited.
    kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
  done
  if (( STARTED_STACK )); then
    echo "Stopping Docker stack…"
    "${COMPOSE[@]}" stop
  fi
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

need docker
need pnpm
need bash

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running." >&2
  exit 1
fi

if ! command -v setsid >/dev/null 2>&1; then
  echo "Missing required command: setsid" >&2
  exit 1
fi

if ! bash -c 'sleep 0 & wait -n' >/dev/null 2>&1; then
  echo "This launcher requires Bash with 'wait -n' support." >&2
  exit 1
fi

dump_failed_containers() {
  local ids
  # Include exited/dead and restarting; --wait failures often leave a service crash-looping.
  ids="$("${COMPOSE[@]}" ps -aq --status exited --status dead --status restarting 2>/dev/null || true)"
  if [[ -z "${ids}" ]]; then
    return 0
  fi

  echo
  echo "Docker stack failed to become healthy. Logs from failed containers:" >&2
  echo >&2
  while IFS= read -r id; do
    [[ -z "${id}" ]] && continue
    local name
    name="$(docker inspect -f '{{.Name}} ({{.State.Status}}, exit {{.State.ExitCode}})' "${id}" 2>/dev/null | sed 's#^/##')"
    echo "──── ${name} ────" >&2
    docker logs --tail 80 "${id}" >&2 || true
    echo >&2
  done <<<"${ids}"
}

trap cleanup EXIT INT TERM

echo "Starting Bifrost Docker stack…"
if ! "${COMPOSE[@]}" up --build -d --wait; then
  dump_failed_containers
  exit 1
fi
STARTED_STACK=1

ensure_pnpm() {
  local app="$1"
  local dir="$ROOT/web/$app"
  local lock="$dir/pnpm-lock.yaml"
  local stamp="$dir/node_modules/.modules.yaml"
  if [[ ! -d "$dir/node_modules" ]] || [[ ! -f "$lock" ]] || [[ ! -f "$stamp" ]] || [[ "$lock" -nt "$stamp" ]]; then
    echo "Installing $app dependencies…"
    if [[ -f "$lock" ]]; then
      (cd "$dir" && pnpm install --frozen-lockfile)
    else
      (cd "$dir" && pnpm install)
    fi
  fi
}

ensure_pnpm workshop
ensure_pnpm orchestrator

echo "Starting workshop UI on http://127.0.0.1:5173 …"
setsid pnpm --dir "$ROOT/web/workshop" run dev -- --host 127.0.0.1 --port 5173 --strictPort </dev/null &
PIDS+=($!)

echo "Starting orchestrator UI on http://127.0.0.1:5174 …"
setsid pnpm --dir "$ROOT/web/orchestrator" run dev -- --host 127.0.0.1 --port 5174 --strictPort </dev/null &
PIDS+=($!)

cat <<EOF

Bifrost local stack is up.

  Workshop UI      http://127.0.0.1:5173
  Orchestrator UI  http://127.0.0.1:5174
  Work items API   http://127.0.0.1:8080
  Orchestrator API http://127.0.0.1:8081
  Skills API       http://127.0.0.1:8082
  RabbitMQ mgmt    http://127.0.0.1:15672  (bifrost / bifrost)

Ctrl+C stops the frontends and the Docker stack (volumes are kept).

EOF

wait -n "${PIDS[@]}"
exit 1
