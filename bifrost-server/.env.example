# Absolute host path for per-run workspaces (Docker-outside-Docker bind mounts).
# Compose mounts this at /workspaces in the worker; docker run -v uses this host path.
# ./scripts/run-script-node.mjs loads this file and writes BIFROST_WORKSPACES_HOST_PATH if missing.
BIFROST_WORKSPACES_HOST_PATH=/absolute/path/to/bifrost/.bifrost-workspaces

# Optional smoke-script overrides (also read by ./scripts/run-script-node.mjs):
# WORK_ITEMS_URL=http://localhost:8080
# ORCHESTRATOR_URL=http://localhost:8081
# WORKFLOWS_URL=http://localhost:8083
# TIMEOUT_SECS=60
